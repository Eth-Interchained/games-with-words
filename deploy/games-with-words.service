[Unit]
Description=Games with Words
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/games-with-words
Environment=NODE_ENV=production
Environment=PORT=3210
Environment=HOST=127.0.0.1
Environment=PUBLIC_URL=https://words.interchained.org
Environment=LOG_LEVEL=1
# openssl rand -hex 32 — without this, a restart invalidates every live game
Environment=ROOM_SECRET=CHANGE_ME
ExecStart=/usr/bin/node server/index.ts
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# the process needs nothing but its own directory
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/games-with-words

[Install]
WantedBy=multi-user.target
