{
  "name": "games-with-words",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Three words. Everyone has a different story.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "node scripts/build-static.mjs",
    "build:all": "npm run build && npm run build:static",
    "start": "node server/index.ts",
    "test": "node --experimental-strip-types tests/run.ts && npm run build:static --silent && node tests/passandplay.test.mjs",
    "test:engine": "node --experimental-strip-types tests/run.ts",
    "test:static": "node scripts/build-static.mjs && node tests/passandplay.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eth-Interchained/games-with-words.git"
  }
}
